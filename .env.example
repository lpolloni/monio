# Monio environment variables.
# DEV: run `npm run dev:services` — it starts Supabase and writes .env.local with
# the real local credentials (never commit .env.local).

# development | test | staging | production  (seeds and the worker refuse production)
APP_ENV=development

# --- Supabase -----------------------------------------------------------------
# Browser-visible (embedded at build time — rebuild per environment).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Used by the seed, the worker and reference-data upserts. Never expose.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: the app never reads it (it talks to Supabase through the URL + keys above).
# Direct Postgres connection for tooling, e.g. `psql "$SUPABASE_DB_URL"` or
# `supabase db push --db-url "$SUPABASE_DB_URL"` to apply migrations to staging.
# Format: postgresql://USER:PASSWORD@HOST:PORT/postgres
#   - Supabase CLI (`supabase start`): user `postgres`, password `postgres`, port 54322
#     (`supabase status` on that machine prints the exact value as "DB URL").
#   - Self-hosted Docker (supabase/docker): password = POSTGRES_PASSWORD in that
#     server's .env; via the pooler, port 5432 and user `postgres.<POOLER_TENANT_ID>`.
# Real staging/production passwords go in an untracked file (.env.local), never here.
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- AI (provider-independent) --------------------------------------------------
# mock | omlx | cloud | disabled
AI_PROVIDER=mock
# oMLX / OpenAI-compatible server (example values; private network endpoints are
# not reachable from cloud sandboxes).
AI_BASE_URL=http://192.168.68.115:8000/v1
AI_API_KEY=
AI_MODEL=Qwen3.5-9B-MLX-4bit
AI_TIMEOUT_MS=20000
# cloud only: openai | openrouter | anthropic | generic
AI_CLOUD_FLAVOR=
# Must be true AND the user must consent in Settings before any financial data is
# sent to a cloud provider. There is never an automatic fallback to the cloud.
AI_ALLOW_CLOUD_DOCUMENTS=false

# --- Blockchain (watch-only) ------------------------------------------------------
# mock | live   (live: Esplora for Bitcoin, Blockscout/JSON-RPC for EVM)
BLOCKCHAIN_PROVIDER=mock
BLOCKCHAIN_API_URL=
BLOCKCHAIN_API_KEY=

# --- Exchange rates & prices ----------------------------------------------------
# mock | live   (live: Frankfurter/ECB for fiat, CoinGecko for crypto)
EXCHANGE_RATE_PROVIDER=mock
EXCHANGE_RATE_API_URL=
EXCHANGE_RATE_API_KEY=

# --- Import -------------------------------------------------------------------------
IMPORT_MAX_FILE_MB=15
